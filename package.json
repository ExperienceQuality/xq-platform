{
  "name": "xq-test-platform",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExperienceQuality/node-test-kit.git"
  },
  "packageManager": "pnpm@12.10.0",
  "description": "A platform-owned Vitest foundation for backend functional E2E tests.",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "check": "pnpm run verify:structure && pnpm run lint && pnpm run format:check && pnpm run build && pnpm --recursive --if-present run check",
    "lint": "eslint .",
    "format": "prettier --write eslint.config.js .prettierrc.json package.json pnpm-workspace.yaml scripts/verify-packages.mjs .github/workflows/build.yml",
    "format:check": "prettier --check eslint.config.js .prettierrc.json package.json pnpm-workspace.yaml scripts/verify-packages.mjs .github/workflows/build.yml",
    "test": "pnpm --filter @experiencequality/rest-client --filter @experiencequality/db --filter @experiencequality/stub --filter @experiencequality/core --filter @experiencequality/test --workspace-concurrency=1 run test",
    "test:e2e": "pnpm --filter @experiencequality/showcase-backend-e2e run test",
    "showcase": "pnpm --filter @experiencequality/showcase-backend-e2e run test",
    "showcase:app": "pnpm --filter @experiencequality/showcase-backend-e2e run start",
    "pack": "pnpm run verify:packages",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "ci:build": "pnpm run verify:structure && pnpm run verify:packages",
    "ci:cucumber": "pnpm run build && node scripts/verify-cucumber-report.mjs",
    "ci:test": "node scripts/ci-test.mjs",
    "ci:release": "node scripts/ci-test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.0.0"
  }
}
