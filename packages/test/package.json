{
  "name": "@experiencequality/test",
  "version": "1.0.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExperienceQuality/xq-platform.git",
    "directory": "packages/test"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "description": "A platform-owned Vitest foundation for backend functional E2E tests.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/test.d.ts",
      "import": "./dist/vitest/test.js"
    },
    "./vitest/config": {
      "types": "./dist/vitest/config.d.ts",
      "import": "./dist/vitest/config.js"
    },
    "./cucumber": {
      "types": "./dist/cucumber/index.d.ts",
      "import": "./dist/cucumber/index.js"
    },
    "./cucumber/config": {
      "types": "./dist/cucumber/config.d.ts",
      "import": "./dist/cucumber/config.js"
    },
    "./cucumber/register": {
      "types": "./dist/cucumber/register.d.ts",
      "import": "./dist/cucumber/register.js"
    },
    "./cucumber/bootstrap": {
      "types": "./dist/cucumber/bootstrap.d.ts",
      "import": "./dist/cucumber/bootstrap.js"
    },
    "./cucumber/plugin": {
      "types": "./dist/cucumber/plugin.d.ts",
      "import": "./dist/cucumber/plugin.js"
    },
    "./cucumber/json": {
      "types": "./dist/cucumber/json.d.ts",
      "import": "./dist/cucumber/json.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:postgres": "vitest run --config vitest.database.config.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cucumber/messages": "^34.2.1",
    "@experiencequality/core": "workspace:*",
    "@experiencequality/db": "workspace:*",
    "@experiencequality/rest-client": "workspace:*",
    "@experiencequality/stub": "workspace:*",
    "pactum": "^3.9.1",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@cucumber/cucumber": ">=13.2.1 <14",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@cucumber/cucumber": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
}
