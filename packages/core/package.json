{
  "name": "@experiencequality/core",
  "version": "1.0.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExperienceQuality/node-test-kit.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts packages/core/test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@experiencequality/rest-client": "workspace:*",
    "@experiencequality/stub": "workspace:*"
  },
  "files": [
    "dist",
    "package.json"
  ]
}
