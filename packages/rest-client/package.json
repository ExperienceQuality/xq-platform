{
  "name": "@experiencequality/rest-client",
  "version": "1.0.3",
  "repository": {
    "type": "git",
    "url": "https://github.com/ExperienceQuality/node-test-kit.git",
    "directory": "packages/rest-client"
  },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -p tsconfig.test.json --noEmit",
